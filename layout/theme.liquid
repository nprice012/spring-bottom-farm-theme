<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% assign seo_title = page_title | default: shop.name %}
  {% assign seo_description = page_description | strip_html %}
  {% if template.name == 'index' %}
    {% assign seo_title = 'Spring Bottom Farm | Farm Fresh Food in Freeland, MD' %}
    {% assign seo_description = 'Spring Bottom Farm is a family farm in Freeland, Maryland offering pasture-raised eggs, farm-raised beef, Thanksgiving turkeys, hay, firewood and seasonal farm products.' %}
  {% elsif template.name == 'product' and product %}
    {% assign seo_title = product.title | append: ' | Spring Bottom Farm' %}
  {% endif %}
  {% if seo_description == blank %}
    {% assign seo_description = 'Shop fresh, locally raised food and farm products from Spring Bottom Farm in Freeland, Maryland.' %}
  {% endif %}
  <title>{{ seo_title | escape }}</title>
  <meta name="description" content="{{ seo_description | escape }}">
  <meta name="robots" content="index,follow">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:description" content="{{ seo_description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:site_name" content="Spring Bottom Farm">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ seo_description | escape }}">
  {{ content_for_header }}
  {{ 'sbf.css' | asset_url | stylesheet_tag }}
</head>
<body>
  {% section 'sbf-header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'sbf-footer' %}

  {% assign turkey_popup_product = blank %}
  {% for popup_product in collections.all.products %}
    {% if popup_product.title == '2026 Thanksgiving Turkey Deposit' %}
      {% assign turkey_popup_product = popup_product %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if turkey_popup_product != blank %}
    <div id="SbfTurkeyPopup" class="sbf-turkey-popup" aria-hidden="true">
      <div class="sbf-turkey-popup-backdrop" data-turkey-popup-close></div>
      <div class="sbf-turkey-popup-card" role="dialog" aria-modal="true" aria-labelledby="SbfTurkeyPopupTitle">
        <button type="button" class="sbf-turkey-popup-close" aria-label="Close" data-turkey-popup-close>&times;</button>
        <div class="sbf-turkey-popup-top">
          <div class="sbf-turkey-popup-eyebrow">SPRING BOTTOM FARM</div>
          <h2 id="SbfTurkeyPopupTitle">THANKSGIVING TURKEYS<br>ARE NOW OPEN</h2>
          <div class="sbf-turkey-popup-rule"></div>
          <p class="sbf-turkey-popup-subtitle">PASTURE-RAISED &nbsp;•&nbsp; GMO-FREE &nbsp;•&nbsp; $5.99/LB</p>
        </div>
        <div class="sbf-turkey-popup-body">
          <div class="sbf-turkey-popup-deposit"><strong>$30</strong><span>NON-REFUNDABLE DEPOSIT</span></div>
          <p class="sbf-turkey-popup-copy">Reserve your Thanksgiving turkey today. Your $30 deposit is applied toward the final price.</p>
          <a class="sbf-turkey-popup-button" href="{{ turkey_popup_product.url }}">RESERVE YOUR TURKEY</a>
          <p class="sbf-turkey-popup-note"><strong>Farm pickup only.</strong> Pickup is at Spring Bottom Farm in Freeland, Maryland. We’ll email you when your turkey is ready.</p>
        </div>
      </div>
    </div>

    <style>
      .sbf-turkey-popup{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s ease,visibility .2s ease}.sbf-turkey-popup.is-open{opacity:1;visibility:visible;pointer-events:auto}.sbf-turkey-popup-backdrop{position:absolute;inset:0;background:rgba(20,27,22,.78)}.sbf-turkey-popup-card{position:relative;z-index:1;width:min(560px,100%);background:#f7f4ed;color:#243126;box-shadow:0 24px 70px rgba(0,0,0,.35);border-radius:4px;overflow:hidden}.sbf-turkey-popup-top{padding:46px 46px 30px;text-align:center}.sbf-turkey-popup-eyebrow{font-size:12px;font-weight:800;letter-spacing:.18em;margin-bottom:18px}.sbf-turkey-popup-content h2,.sbf-turkey-popup-top h2{font-size:clamp(34px,6vw,52px);line-height:.98;letter-spacing:-.045em;margin:0}.sbf-turkey-popup-rule{width:70px;height:2px;background:#243126;margin:25px auto 20px}.sbf-turkey-popup-subtitle{font-size:14px;font-weight:800;letter-spacing:.1em;margin:0}.sbf-turkey-popup-body{padding:0 46px 42px;text-align:center}.sbf-turkey-popup-deposit{display:flex;align-items:center;justify-content:center;gap:12px;background:#243126;color:#fff;padding:18px 20px;margin:0 0 22px}.sbf-turkey-popup-deposit strong{font-size:34px;line-height:1}.sbf-turkey-popup-deposit span{font-size:15px;font-weight:900;letter-spacing:.06em}.sbf-turkey-popup-copy{font-size:17px;line-height:1.5;max-width:430px;margin:0 auto 24px}.sbf-turkey-popup-button{display:flex;align-items:center;justify-content:center;min-height:62px;background:#243126;color:#fff;text-decoration:none;font-size:16px;font-weight:900;letter-spacing:.08em;padding:16px 22px}.sbf-turkey-popup-button:hover{background:#18231b}.sbf-turkey-popup-note{font-size:13px;line-height:1.5;color:#5b625b;max-width:430px;margin:18px auto 0}.sbf-turkey-popup-close{position:absolute;z-index:2;top:14px;right:14px;width:38px;height:38px;border:0;border-radius:50%;background:#fff;color:#243126;font-size:26px;line-height:1;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.12)}.sbf-turkey-popup-close:hover{background:#eeeae0}.sbf-turkey-popup.is-open .sbf-turkey-popup-card{animation:sbfTurkeyPopupIn .2s ease both}@keyframes sbfTurkeyPopupIn{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}@media screen and (max-width:749px){.sbf-turkey-popup{padding:14px}.sbf-turkey-popup-card{max-height:calc(100vh - 28px);overflow:auto}.sbf-turkey-popup-top{padding:42px 24px 25px}.sbf-turkey-popup-top h2{font-size:35px}.sbf-turkey-popup-subtitle{font-size:11px;letter-spacing:.07em}.sbf-turkey-popup-body{padding:0 24px 28px}.sbf-turkey-popup-deposit{display:block;padding:16px 12px}.sbf-turkey-popup-deposit strong{display:block;font-size:32px;margin-bottom:4px}.sbf-turkey-popup-deposit span{font-size:13px}.sbf-turkey-popup-copy{font-size:16px}.sbf-turkey-popup-button{min-height:60px;font-size:15px}}
    </style>

    <script>
      (function(){
        var popup=document.getElementById('SbfTurkeyPopup');
        if(!popup)return;
        var storageKey='sbfTurkeyPopupSeen2026';
        function closePopup(){popup.classList.remove('is-open');popup.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
        function openPopup(){popup.classList.add('is-open');popup.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';try{sessionStorage.setItem(storageKey,'1')}catch(e){}}
        popup.querySelectorAll('[data-turkey-popup-close]').forEach(function(el){el.addEventListener('click',closePopup)});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'&&popup.classList.contains('is-open'))closePopup()});
        var seen=false;try{seen=sessionStorage.getItem(storageKey)==='1'}catch(e){}
        if(!seen){setTimeout(openPopup,1200)}
      })();
    </script>
  {% endif %}

  <script>
    (function () {
      function scrollToHash() {
        if (!window.location.hash) return;
        var target = document.getElementById(window.location.hash.substring(1));
        if (target) {
          setTimeout(function () {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 50);
        }
      }

      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href*="#farm-stand"], a[href*="#our-farm"]');
        if (!link) return;
        var targetUrl = new URL(link.href, window.location.origin);
        if (targetUrl.pathname !== window.location.pathname) return;
        var target = document.getElementById(targetUrl.hash.substring(1));
        if (!target) return;
        event.preventDefault();
        history.pushState(null, '', targetUrl.hash);
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      window.addEventListener('load', scrollToHash);
      window.addEventListener('hashchange', scrollToHash);
    })();
  </script>
</body>
</html>