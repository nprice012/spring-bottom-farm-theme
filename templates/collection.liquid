<div class="sbf-collection-page">
  <div class="sbf-wrap">
    <div class="sbf-eyebrow">Spring Bottom Farm</div>
    <h1>{{ collection.title | default: 'Shop the Farm' }}</h1>
    {% if collection.description != blank %}<div class="sbf-collection-description">{{ collection.description }}</div>{% endif %}

    {% if collection.handle == 'all' %}
      <section class="sbf-shop-categories" aria-label="Shop by category">
        <section class="sbf-category-feature" aria-label="Eggs and egg subscription">
          <div class="sbf-category-feature-image">
            <img src="https://cdn.shopify.com/s/files/1/0773/6564/1406/collections/ChatGPT_Image_Aug_22_2026_10_10_48_PM.png?v=1792028368" alt="Pasture-raised eggs from Spring Bottom Farm" loading="eager">
          </div>
          <div class="sbf-category-feature-copy">
            <span class="sbf-category-eyebrow">Your farm-fresh staple</span>
            <strong>Make eggs one less thing to think about.</strong>
            <span>Shop our pasture-raised eggs and choose a recurring subscription for convenient home delivery.</span>
            <span class="sbf-category-subnote">Flexible deliveries for your routine.</span>
            <a class="sbf-category-primary-link" href="/products/farm-fresh-eggs-1-dozen">Shop Eggs &amp; Start a Subscription <span aria-hidden="true">→</span></a>
          </div>
        </section>
        <div class="sbf-category-grid">
          <a class="sbf-category-card" href="/collections/meat-freezer">
            <img src="https://cdn.shopify.com/s/files/1/0773/6564/1406/collections/fresh-chicken-breast.png?v=1792028373" alt="Pasture-raised chicken from Spring Bottom Farm" loading="lazy">
            <span class="sbf-category-card-copy"><strong>Meat &amp; Freezer</strong><span>Chicken, beef shares and seasonal turkey</span><span class="sbf-category-link-label">Shop meat →</span></span>
          </a>
          <a class="sbf-category-card" href="/collections/flourish-ferment-co">
            <img src="https://cdn.shopify.com/s/files/1/0773/6564/1406/collections/flourish_ferment.webp?v=1792027560" alt="Flourish and Ferment artisan bakery products" loading="lazy">
            <span class="sbf-category-card-copy"><strong>Bread &amp; Bakery</strong><span>Flourish &amp; Ferment favorites</span><span class="sbf-category-link-label">Shop bakery →</span></span>
          </a>
          <a class="sbf-category-card" href="/collections/pantry-snacks">
            <img src="https://cdn.shopify.com/s/files/1/0773/6564/1406/collections/TeriyakiforWebsite.jpg?v=1792028382" alt="VP Beef Jerky snacks" loading="lazy">
            <span class="sbf-category-card-copy"><strong>Pantry &amp; Snacks</strong><span>Jerky and snack favorites</span><span class="sbf-category-link-label">Shop snacks →</span></span>
          </a>
          <a class="sbf-category-card" href="/collections/farm-stand-goods">
            <img src="https://cdn.shopify.com/s/files/1/0773/6564/1406/collections/IMG_8479.jpg?v=1792028387" alt="Bundled firewood from Spring Bottom Farm" loading="lazy">
            <span class="sbf-category-card-copy"><strong>Farm Stand &amp; Goods</strong><span>Firewood and farm merchandise</span><span class="sbf-category-link-label">Shop goods →</span></span>
          </a>
        </div>
        <a class="sbf-shop-all-link" href="#sbf-all-products">Shop All Products <span aria-hidden="true">↓</span></a>
      </section>
    {% endif %}

    {% if collection.products_count > 0 %}
      {% assign featured_handles = 'farm-fresh-eggs-1-dozen,pasture-raised-boneless-skinless-chicken-breast' | split: ',' %}
      <div class="sbf-product-grid-list" id="sbf-all-products">
        {% if collection.handle == 'all' %}
          {% for product in collection.products %}
            {% if featured_handles contains product.handle %}
              <a class="sbf-product-card" href="{{ product.url }}">
                <div class="sbf-product-image-wrap">
                  {% if product.featured_image %}{{ product.featured_image | image_url: width:700 | image_tag: loading:'eager', widths:'400,500,600,700', sizes:'(min-width: 1000px) 33vw, (min-width: 750px) 50vw, 50vw', alt:product.title }}{% endif %}
                </div>
                <div class="sbf-product-info"><h2>{{ product.title }}</h2><div class="sbf-product-price">{{ product.price | money }}</div></div>
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
        {% for product in collection.products %}
          {% unless collection.handle == 'all' and featured_handles contains product.handle %}
            <a class="sbf-product-card" href="{{ product.url }}">
              <div class="sbf-product-image-wrap">
                {% if product.featured_image %}{{ product.featured_image | image_url: width:700 | image_tag: loading:'lazy', widths:'400,500,600,700', sizes:'(min-width: 1000px) 33vw, (min-width: 750px) 50vw, 50vw', alt:product.title }}{% endif %}
              </div>
              <div class="sbf-product-info"><h2>{{ product.title }}</h2><div class="sbf-product-price">{{ product.price | money }}</div></div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    {% else %}<p>We're getting the farm shop ready. Check back soon.</p>{% endif %}
  </div>
</div>
<style>
.sbf-collection-page{background:#f7f4ed;color:#243126;padding:72px 24px;min-height:60vh}
.sbf-wrap{max-width:1120px;margin:0 auto}
.sbf-collection-page h1{font-size:clamp(42px,5vw,64px);line-height:1;margin:0 0 22px;letter-spacing:-.04em}
.sbf-collection-description{font-size:18px;line-height:1.6;max-width:700px;margin-bottom:42px}
.sbf-shop-categories{margin:30px 0 54px}
.sbf-category-feature{display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr);align-items:stretch;min-height:300px;background:#ebe8dc;border:1px solid #d7d0bd;overflow:hidden}
.sbf-category-feature-image{display:flex;align-items:center;justify-content:center;min-width:0;padding:18px;background:#f0ebdf}
.sbf-category-feature-image img{display:block;width:100%;height:100%;max-height:340px;aspect-ratio:4/3;object-fit:contain;object-position:center}
.sbf-category-feature-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:38px 42px;gap:12px}
.sbf-category-eyebrow{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#53634d}
.sbf-category-feature-copy strong{font-size:clamp(29px,3.3vw,42px);line-height:1.05;letter-spacing:-.035em;max-width:520px}
.sbf-category-feature-copy>span:not(.sbf-category-eyebrow):not(.sbf-category-subnote){font-size:16px;line-height:1.55;max-width:490px}
.sbf-category-subnote{font-size:13px;line-height:1.4;color:#555d53}
.sbf-category-primary-link{display:inline-flex;align-items:center;justify-content:center;gap:12px;margin-top:4px;padding:15px 19px;background:#243126;color:#fff;text-decoration:none;font-size:14px;font-weight:750;line-height:1.25}
.sbf-category-primary-link:hover{background:#354936}
.sbf-category-card:hover .sbf-category-link-label{text-decoration:underline;text-underline-offset:4px}
.sbf-category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:20px}
.sbf-category-card{display:flex;flex-direction:column;color:inherit;text-decoration:none;min-width:0;background:#fffdf8;border:1px solid #e6e0d4;overflow:hidden}
.sbf-category-card>img{display:block;width:100%;aspect-ratio:4/3;object-fit:contain;object-position:center;background:#f0ebdf;padding:10px;box-sizing:border-box}
.sbf-category-card-copy{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:18px 20px 20px}
.sbf-category-card-copy strong{font-size:21px;line-height:1.2}
.sbf-category-card-copy>span:not(.sbf-category-link-label){font-size:14px;line-height:1.45;color:#555d53}
.sbf-shop-all-link{display:flex;align-items:center;justify-content:center;gap:12px;margin:24px auto 0;padding:15px 22px;max-width:280px;background:#243126;color:#fff;text-decoration:none;font-size:14px;font-weight:750}
.sbf-shop-all-link:hover{background:#354936}
#sbf-all-products{scroll-margin-top:28px}
.sbf-product-grid-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 28px;align-items:start}
.sbf-product-card{display:block;color:inherit;text-decoration:none;min-width:0}
.sbf-product-image-wrap{width:100%;aspect-ratio:1/1;overflow:hidden;background:#eee9df;margin-bottom:16px}
.sbf-product-card img{display:block;width:100%;height:100%;padding:10px;box-sizing:border-box;object-fit:contain;object-position:center;background:#f0ebdf;transition:transform .25s ease}
.sbf-product-card:hover img{transform:scale(1.015)}
.sbf-product-info{padding:0 3px}
.sbf-product-card h2{font-size:21px;line-height:1.2;margin:0 0 7px;font-weight:600}
.sbf-product-price{font-size:17px;font-weight:700}
@media(max-width:749px){.sbf-collection-page{padding:48px 18px}.sbf-category-feature{grid-template-columns:1fr}.sbf-category-feature-image{padding:12px}.sbf-category-feature-image img{height:auto;max-height:260px;aspect-ratio:4/3}.sbf-category-feature-copy{padding:26px 22px}.sbf-category-feature-copy strong{font-size:clamp(28px,7vw,36px)}.sbf-category-feature-copy>span:not(.sbf-category-eyebrow):not(.sbf-category-subnote){font-size:15px}.sbf-category-primary-link{width:100%;box-sizing:border-box;text-align:center}.sbf-category-grid{gap:14px;margin-top:14px}.sbf-category-card-copy{padding:14px}.sbf-category-card-copy strong{font-size:18px}.sbf-shop-all-link{max-width:none;width:100%}.sbf-product-grid-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 16px}.sbf-product-card h2{font-size:18px}}
@media(max-width:480px){.sbf-product-grid-list{gap:28px 12px}.sbf-product-card h2{font-size:16px}}
</style>