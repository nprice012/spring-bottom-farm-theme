<div class="sbf-collection-page">
  <div class="sbf-wrap">
    <div class="sbf-eyebrow">Spring Bottom Farm</div>
    <h1>{{ collection.title | default: 'Shop the Farm' }}</h1>
    {% if collection.description != blank %}<div class="sbf-collection-description">{{ collection.description }}</div>{% endif %}

    {% if collection.products_count > 0 %}
      {% if collection.handle == 'all' %}
        <div class="sbf-featured-grid">
          {% assign featured_handles = 'farm-fresh-eggs-1-dozen,pasture-raised-boneless-skinless-chicken-breast' | split: ',' %}
          {% for featured_handle in featured_handles %}
            {% assign featured_product = all_products[featured_handle] %}
            {% if featured_product != blank %}
              <a class="sbf-product-card sbf-featured-card" href="{{ featured_product.url }}">
                {% if featured_product.featured_image %}
                  {{ featured_product.featured_image | image_url: width:1000 | image_tag: loading:'eager', widths:'500,700,900,1000', sizes:'(min-width: 750px) 50vw, 90vw', alt:featured_product.title }}
                {% endif %}
                <div class="sbf-card-copy">
                  <div class="sbf-card-label">{{ forloop.index == 1 | ternary: 'Fresh from our hens', 'Fresh from the farm' }}</div>
                  <h2>{{ featured_product.title }}</h2>
                  <div>{{ featured_product.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>

        <div class="sbf-shop-heading">
          <div class="sbf-eyebrow">More from the farm</div>
          <h2>Shop Everything</h2>
        </div>
      {% endif %}

      <div class="sbf-product-grid-list">
        {% for product in collection.products %}
          {% unless collection.handle == 'all' and featured_handles contains product.handle %}
            <a class="sbf-product-card" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width:600 | image_tag: loading:'lazy', widths:'300,400,500,600', sizes:'(min-width: 1000px) 300px, (min-width: 750px) 30vw, 80vw', alt:product.title }}
              {% endif %}
              <h2>{{ product.title }}</h2>
              <div>{{ product.price | money }}</div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    {% else %}
      <p>We're getting the farm shop ready. Check back soon.</p>
    {% endif %}
  </div>
</div>

<style>
  .sbf-collection-page{background:#f7f4ed;color:#243126;padding:80px 24px;min-height:60vh}
  .sbf-wrap{max-width:1100px;margin:0 auto}
  .sbf-collection-page h1{font-size:clamp(44px,6vw,72px);line-height:1;margin:0 0 25px;letter-spacing:-.04em}
  .sbf-collection-description{font-size:18px;line-height:1.6;max-width:700px;margin-bottom:45px}
  .sbf-featured-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin:10px 0 75px}
  .sbf-featured-card{max-width:none}
  .sbf-featured-card img{width:100%;max-width:none;height:auto;aspect-ratio:1/1;object-fit:cover;margin-bottom:20px}
  .sbf-card-copy{padding:0 4px}
  .sbf-card-label{font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;margin-bottom:8px;opacity:.7}
  .sbf-featured-card h2{font-size:clamp(26px,3vw,38px);line-height:1.05;margin:0 0 10px}
  .sbf-featured-card .sbf-card-copy>div:last-child{font-size:19px;font-weight:700}
  .sbf-shop-heading{margin:0 0 30px}
  .sbf-shop-heading h2{font-size:clamp(30px,4vw,46px);line-height:1;margin:0;letter-spacing:-.03em}
  .sbf-product-grid-list{display:grid;grid-template-columns:repeat(3,minmax(0,320px));gap:42px;align-items:start}
  .sbf-product-card{display:block;color:inherit;text-decoration:none}
  .sbf-product-card img{display:block;width:100%;max-width:320px;height:320px;aspect-ratio:1/1;object-fit:cover;margin-bottom:18px}
  .sbf-product-card h2{font-size:22px;line-height:1.15;margin:0 0 8px}
  .sbf-product-card div{font-size:17px;font-weight:700}
  @media screen and (max-width:999px){.sbf-product-grid-list{grid-template-columns:repeat(2,minmax(0,320px))}}
  @media screen and (max-width:749px){.sbf-collection-page{padding:50px 20px}.sbf-featured-grid{grid-template-columns:1fr;gap:45px;margin-bottom:60px}.sbf-product-grid-list{grid-template-columns:1fr;justify-items:start}.sbf-product-card,.sbf-product-card img{max-width:320px}.sbf-product-card img{height:320px}}
</style>