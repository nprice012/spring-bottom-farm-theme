<div class="sbf-collection-page">
  <div class="sbf-wrap">
    <div class="sbf-eyebrow">Spring Bottom Farm</div>
    <h1>{{ collection.title | default: 'Shop the Farm' }}</h1>
    {% if collection.description != blank %}<div class="sbf-collection-description">{{ collection.description }}</div>{% endif %}

    {% if collection.products_count > 0 %}
      {% assign featured_handles = 'farm-fresh-eggs-1-dozen,pasture-raised-boneless-skinless-chicken-breast' | split: ',' %}
      <div class="sbf-product-grid-list">
        {% for product in collection.products %}
          {% if featured_handles contains product.handle %}
            <a class="sbf-product-card" href="{{ product.url }}">
              <div class="sbf-product-image-wrap">
                {% if product.featured_image %}{{ product.featured_image | image_url: width:700 | image_tag: loading:'eager', widths:'400,500,600,700', sizes:'(min-width: 1000px) 33vw, (min-width: 750px) 50vw, 50vw', alt:product.title }}{% endif %}
              </div>
              <div class="sbf-product-info"><h2>{{ product.title }}</h2><div class="sbf-product-price">{{ product.price | money }}</div></div>
            </a>
          {% endif %}
        {% endfor %}
        {% for product in collection.products %}
          {% unless featured_handles contains product.handle %}
            <a class="sbf-product-card" href="{{ product.url }}">
              <div class="sbf-product-image-wrap">
                {% if product.featured_image %}{{ product.featured_image | image_url: width:700 | image_tag: loading:'lazy', widths:'400,500,600,700', sizes:'(min-width: 1000px) 33vw, (min-width: 750px) 50vw, 50vw', alt:product.title }}{% endif %}
              </div>
              <div class="sbf-product-info"><h2>{{ product.title }}</h2><div class="sbf-product-price">{{ product.price | money }}</div></div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    {% else %}<p>We're getting the farm shop ready. Check back soon.</p>{% endif %}
  </div>
</div>
<style>
.sbf-collection-page{background:#f7f4ed;color:#243126;padding:72px 24px;min-height:60vh}.sbf-wrap{max-width:1120px;margin:0 auto}.sbf-collection-page h1{font-size:clamp(42px,5vw,64px);line-height:1;margin:0 0 22px;letter-spacing:-.04em}.sbf-collection-description{font-size:18px;line-height:1.6;max-width:700px;margin-bottom:42px}.sbf-product-grid-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:52px 32px;align-items:start}.sbf-product-card{display:block;color:inherit;text-decoration:none;min-width:0}.sbf-product-image-wrap{width:100%;aspect-ratio:1/1;overflow:hidden;background:#eee9df;margin-bottom:16px}.sbf-product-card img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.sbf-product-card:hover img{transform:scale(1.025)}.sbf-product-info{padding:0 3px}.sbf-product-card h2{font-size:21px;line-height:1.2;margin:0 0 7px;font-weight:600}.sbf-product-price{font-size:17px;font-weight:700}@media(max-width:749px){.sbf-collection-page{padding:48px 18px}.sbf-product-grid-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 16px}.sbf-product-card h2{font-size:18px}}@media(max-width:480px){.sbf-product-grid-list{gap:30px 12px}.sbf-product-card h2{font-size:16px}}
</style>