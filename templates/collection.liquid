<div class="sbf-collection-page">
  <div class="sbf-wrap">
    <div class="sbf-eyebrow">Spring Bottom Farm</div>
    <h1>{{ collection.title | default: 'Shop the Farm' }}</h1>
    {% if collection.description != blank %}<div class="sbf-collection-description">{{ collection.description }}</div>{% endif %}

    {% if collection.products_count > 0 %}
      <div class="sbf-product-grid-list">
        {% for product in collection.products %}
          <a class="sbf-product-card" href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width:800 | image_tag: loading:'lazy', alt:product.title }}
            {% endif %}
            <h2>{{ product.title }}</h2>
            <div>{{ product.price | money }}</div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p>We're getting the farm shop ready. Check back soon.</p>
    {% endif %}
  </div>
</div>

<style>
  .sbf-collection-page{background:#f7f4ed;color:#243126;padding:80px 24px;min-height:60vh}
  .sbf-collection-page h1{font-size:clamp(44px,6vw,72px);line-height:1;margin:0 0 25px;letter-spacing:-.04em}
  .sbf-collection-description{font-size:18px;line-height:1.6;max-width:700px;margin-bottom:45px}
  .sbf-product-grid-list{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
  .sbf-product-card{color:inherit;text-decoration:none}
  .sbf-product-card img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;margin-bottom:18px}
  .sbf-product-card h2{font-size:22px;margin:0 0 8px}
  .sbf-product-card div{font-size:17px;font-weight:700}
  @media screen and (max-width:749px){.sbf-collection-page{padding:50px 20px}.sbf-product-grid-list{grid-template-columns:1fr}}
</style>