{% if page.handle == 'egg-subscription' %}
  {% assign hero_image = images['IMG_8177_2.jpg'] %}
  {% assign egg_image = images['IMG_7892.jpg'] %}
  {% assign cooler_image = images['IMG_8147.jpg'] %}
  {% assign table_image = images['IMG_8177_2.jpg'] %}
  {% assign carton_image = images['IMG_8146.jpg'] %}

  {% assign egg_product = blank %}
  {% for product in collections.all.products %}
    {% if product.title == 'Pasture-Raised Eggs' %}
      {% assign egg_product = product %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if egg_product != blank %}
    {% assign egg_subscription_url = egg_product.url %}
    <script>
      window.location.replace({{ egg_product.url | json }} + window.location.search);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url={{ egg_product.url }}"></noscript>
  {% else %}
    {% assign egg_subscription_url = routes.all_products_collection_url %}
  {% endif %}

  <style>
    .sbf-egg-page{background:#f7f4ed;color:#243126}
    .sbf-egg-hero{display:grid;grid-template-columns:1.1fr 1fr;min-height:620px}
    .sbf-egg-hero-image{min-height:620px;overflow:hidden}
    .sbf-egg-hero-image img,.sbf-egg-feature-image img,.sbf-egg-gallery-grid img{width:100%;height:100%;object-fit:cover;display:block}
    .sbf-egg-hero-content{display:flex;flex-direction:column;justify-content:center;padding:80px 8%;background:#243b2f;color:#fff}
    .sbf-eyebrow{font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin-bottom:20px}
    .sbf-egg-hero h1{font-size:clamp(48px,6vw,82px);line-height:.98;margin:0 0 28px;letter-spacing:-.04em}
    .sbf-egg-hero p{font-size:20px;line-height:1.6;max-width:600px;margin:0 0 34px}
    .sbf-button{display:inline-flex;align-items:center;justify-content:center;width:fit-content;padding:17px 28px;background:#243126;color:#fff;text-decoration:none;font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .sbf-egg-hero .sbf-button{background:#fff;color:#243126}
    .sbf-button:hover{opacity:.82}
    .sbf-egg-intro{max-width:850px;margin:0 auto;padding:100px 24px 80px;text-align:center}
    .sbf-egg-intro h2,.sbf-egg-plan h2,.sbf-egg-gallery h2{font-size:clamp(38px,5vw,60px);line-height:1.05;letter-spacing:-.03em;margin:0 0 24px}
    .sbf-egg-intro p,.sbf-egg-plan p,.sbf-egg-feature-content p,.sbf-egg-final p{font-size:19px;line-height:1.7}
    .sbf-egg-feature{display:grid;grid-template-columns:1fr 1fr}
    .sbf-egg-feature.reverse .sbf-egg-feature-image{order:2}
    .sbf-egg-feature-image{min-height:500px;overflow:hidden}
    .sbf-egg-feature-content{display:flex;flex-direction:column;justify-content:center;padding:70px 10%;background:#fff}
    .sbf-egg-feature-content h2{font-size:clamp(34px,4vw,52px);line-height:1.05;margin:0 0 22px;letter-spacing:-.03em}
    .sbf-egg-plan{padding:100px 24px;background:#ddd8c9}
    .sbf-egg-plan-inner{max-width:900px;margin:0 auto;text-align:center}
    .sbf-egg-options{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:45px 0}
    .sbf-egg-option{background:#fff;padding:32px 20px}
    .sbf-egg-option strong{display:block;font-size:18px;margin-bottom:10px}
    .sbf-egg-option span{font-size:15px;line-height:1.5}
    .sbf-egg-gallery{padding:100px 24px;background:#f7f4ed}
    .sbf-egg-gallery-inner{max-width:1200px;margin:0 auto}
    .sbf-egg-gallery h2{text-align:center;margin-bottom:50px}
    .sbf-egg-gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .sbf-egg-gallery-grid img{aspect-ratio:1/1}
    .sbf-egg-final{padding:110px 24px;background:#243126;color:#fff;text-align:center}
    .sbf-egg-final-inner{max-width:850px;margin:0 auto}
    .sbf-egg-final h2{font-size:clamp(42px,6vw,70px);line-height:1;margin:0 0 25px;letter-spacing:-.04em}
    .sbf-egg-final .sbf-button{background:#fff;color:#243126}
    @media screen and (max-width:749px){
      .sbf-egg-hero,.sbf-egg-feature{grid-template-columns:1fr}
      .sbf-egg-hero-image{min-height:400px}
      .sbf-egg-hero-content,.sbf-egg-feature-content{padding:55px 25px 65px}
      .sbf-egg-feature.reverse .sbf-egg-feature-image{order:0}
      .sbf-egg-feature-image{min-height:400px}
      .sbf-egg-options,.sbf-egg-gallery-grid{grid-template-columns:1fr}
    }
  </style>

  <div class="sbf-egg-page">
    <section class="sbf-egg-hero">
      <div class="sbf-egg-hero-image">
        {% if hero_image != blank %}<img src="{{ hero_image | image_url: width:1600 }}" alt="Pasture-raised eggs from Spring Bottom Farm" loading="eager">{% endif %}
      </div>
      <div class="sbf-egg-hero-content">
        <div class="sbf-eyebrow">Egg Subscription</div>
        <h1>Fresh eggs,<br>on your schedule.</h1>
        <p>Get pasture-raised eggs from Spring Bottom Farm on a schedule that works for you. Choose weekly or every-other-week and never worry about running out of fresh eggs.</p>
        <a class="sbf-button" href="{{ egg_subscription_url }}">SHOP OUR EGGS</a>
      </div>
    </section>

    <section class="sbf-egg-intro">
      <div class="sbf-eyebrow">The Egg Subscription</div>
      <h2>Fresh eggs without having to think about it.</h2>
      <p>Choose how often you want your eggs and how many you need. We'll have them ready for you on schedule.</p>
    </section>

    {% if egg_image != blank %}
      <section class="sbf-egg-feature">
        <div class="sbf-egg-feature-image"><img src="{{ egg_image | image_url: width:1400 }}" alt="Fresh brown egg from Spring Bottom Farm" loading="lazy"></div>
        <div class="sbf-egg-feature-content"><div class="sbf-eyebrow">Farm Fresh</div><h2>Eggs from our farm to your table.</h2><p>Our hens spend their days outdoors on pasture, and we collect eggs fresh from the flock.</p></div>
      </section>
    {% endif %}

    {% if cooler_image != blank %}
      <section class="sbf-egg-feature reverse">
        <div class="sbf-egg-feature-image"><img src="{{ cooler_image | image_url: width:1400 }}" alt="Fresh eggs packed at Spring Bottom Farm" loading="lazy"></div>
        <div class="sbf-egg-feature-content"><div class="sbf-eyebrow">Simple & Convenient</div><h2>Your eggs are ready when you need them.</h2><p>Select your preferred schedule and quantity. We'll take care of the rest.</p></div>
      </section>
    {% endif %}

    <section class="sbf-egg-plan">
      <div class="sbf-egg-plan-inner">
        <div class="sbf-eyebrow">Choose Your Schedule</div>
        <h2>Make eggs one less thing to worry about.</h2>
        <p>Select the subscription option that fits your household.</p>
        <div class="sbf-egg-options">
          <div class="sbf-egg-option"><strong>Weekly</strong><span>Fresh eggs every week.</span></div>
          <div class="sbf-egg-option"><strong>Every 2 Weeks</strong><span>A fresh supply every other week.</span></div>
          <div class="sbf-egg-option"><strong>Flexible Quantity</strong><span>Choose the quantity that works for your household.</span></div>
        </div>
        <a class="sbf-button" href="{{ egg_subscription_url }}">SHOP OUR EGGS</a>
      </div>
    </section>

    <section class="sbf-egg-gallery">
      <div class="sbf-egg-gallery-inner">
        <div class="sbf-eyebrow" style="text-align:center;">From Our Farm</div>
        <h2>See where your eggs come from.</h2>
        <div class="sbf-egg-gallery-grid">
          {% if table_image != blank %}<img src="{{ table_image | image_url: width:1000 }}" alt="Egg cartons at Spring Bottom Farm" loading="lazy">{% endif %}
          {% if carton_image != blank %}<img src="{{ carton_image | image_url: width:1000 }}" alt="Fresh eggs in a carton" loading="lazy">{% endif %}
          {% if cooler_image != blank %}<img src="{{ cooler_image | image_url: width:1000 }}" alt="Fresh eggs prepared at Spring Bottom Farm" loading="lazy">{% endif %}
        </div>
      </div>
    </section>

    <section class="sbf-egg-final">
      <div class="sbf-egg-final-inner">
        <div class="sbf-eyebrow">Spring Bottom Farm</div>
        <h2>Fresh eggs, on your schedule.</h2>
        <p>Start your Egg Subscription and make sure there's always a fresh supply waiting for you.</p>
        <a class="sbf-button" href="{{ egg_subscription_url }}">SHOP OUR EGGS</a>
      </div>
    </section>
  </div>
{% elsif page.handle == 'our-farm' %}
  <style>
    .sbf-farm-page{background:#f7f4ed;color:#243126}
    .sbf-farm-hero{padding:110px 24px 90px;background:#243b2f;color:#fff;text-align:center}
    .sbf-farm-hero-inner,.sbf-farm-content{max-width:920px;margin:0 auto}
    .sbf-farm-hero .eyebrow,.sbf-farm-content .eyebrow{font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin-bottom:20px}
    .sbf-farm-hero h1{font-size:clamp(48px,7vw,82px);line-height:.98;letter-spacing:-.045em;margin:0 0 25px}
    .sbf-farm-hero p{font-size:20px;line-height:1.6;max-width:720px;margin:0 auto}
    .sbf-farm-content{padding:85px 24px 110px}
    .sbf-farm-content section{margin-bottom:75px}
    .sbf-farm-content h2{font-size:clamp(34px,5vw,52px);line-height:1.05;letter-spacing:-.03em;margin:0 0 20px}
    .sbf-farm-content p{font-size:18px;line-height:1.75;margin:0 0 18px}
    .sbf-farm-products{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:35px}
    .sbf-farm-product{background:#fff;padding:28px}
    .sbf-farm-product strong{display:block;font-size:18px;margin-bottom:8px}
    .sbf-farm-product span{font-size:15px;line-height:1.55}
    @media screen and (max-width:749px){.sbf-farm-hero{padding:75px 24px 65px}.sbf-farm-content{padding:65px 24px 80px}.sbf-farm-products{grid-template-columns:1fr}}
  </style>
  <div class="sbf-farm-page">
    <section class="sbf-farm-hero">
      <div class="sbf-farm-hero-inner">
        <div class="eyebrow">Spring Bottom Farm</div>
        <h1>Our Farm in Freeland, Maryland.</h1>
        <p>A working family farm in Northern Baltimore County, raising quality food, caring for the land, and building a sustainable future.</p>
      </div>
    </section>
    <div class="sbf-farm-content">
      <section>
        <div class="eyebrow">A Working Farm</div>
        <h2>Rooted in Freeland.</h2>
        <p>Spring Bottom Farm is a family-run farm in Freeland, Maryland. We raise food, care for livestock, work the land, and share what we produce with our neighbors throughout Northern Baltimore County and the surrounding area.</p>
        <p>From our pasture-raised eggs and farm-raised beef to Thanksgiving turkeys, hay, firewood, and seasonal farm products, our goal is simple: produce good food and useful farm products while taking care of the land that makes it possible.</p>
      </section>
      <section>
        <div class="eyebrow">What We Do</div>
        <h2>More than a farm stand.</h2>
        <p>Spring Bottom Farm is a working farm first. Our days are spent caring for animals, maintaining pasture, making hay, preparing products, and keeping the farm productive year-round.</p>
        <div class="sbf-farm-products">
          <div class="sbf-farm-product"><strong>Pasture-Raised Eggs</strong><span>Fresh brown eggs collected from our flock and sold directly to local customers.</span></div>
          <div class="sbf-farm-product"><strong>Farm-Raised Beef</strong><span>Beef from cattle raised right here on our family farm.</span></div>
          <div class="sbf-farm-product"><strong>Thanksgiving Turkeys</strong><span>Pasture-raised, GMO-free turkeys available for farm pickup.</span></div>
          <div class="sbf-farm-product"><strong>Hay & Farm Products</strong><span>Hay, firewood, seasonal produce, and other products from our farm and local agricultural work.</span></div>
        </div>
      </section>
      <section>
        <div class="eyebrow">Our Approach</div>
        <h2>Good food starts with good stewardship.</h2>
        <p>We believe a farm should be productive without losing sight of the land, the animals, or the people who depend on it. We focus on practical, responsible farming and on building a farm that can continue to serve our family and our community for years to come.</p>
        <p>We're proud to farm in Freeland and to be part of the local agricultural community in Northern Baltimore County.</p>
      </section>
    </div>
  </div>
{% elsif page.handle == 'wholesale-food-service' %}
  <style>
    .sbf-wholesale{background:#f7f4ed;color:#243126}
    .sbf-wholesale *{box-sizing:border-box}
    .sbf-wholesale-hero{display:grid;grid-template-columns:1fr 1fr;min-height:560px;background:#243b2f;color:#fff}
    .sbf-wholesale-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(45px,7vw,100px);max-width:760px;margin-left:auto}
    .sbf-wholesale-eyebrow{font-size:12px;font-weight:700;letter-spacing:.17em;text-transform:uppercase;margin-bottom:20px}
    .sbf-wholesale-hero h1{font-size:clamp(44px,5.4vw,74px);line-height:.98;letter-spacing:-.045em;margin:0 0 25px}
    .sbf-wholesale-hero p{font-size:18px;line-height:1.7;max-width:590px;margin:0 0 30px}
    .sbf-wholesale-hero-image{min-height:460px;overflow:hidden}
    .sbf-wholesale-hero-image img{width:100%;height:100%;min-height:100%;object-fit:cover;display:block}
    .sbf-wholesale-btn{display:inline-flex;align-items:center;justify-content:center;align-self:flex-start;padding:16px 24px;background:#fff;color:#243126;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;transition:transform .18s ease,opacity .18s ease}
    .sbf-wholesale-btn:hover{transform:translateY(-2px);opacity:.9}
    .sbf-wholesale-trust{display:grid;grid-template-columns:repeat(3,1fr);max-width:1200px;margin:0 auto;padding:0 24px;transform:translateY(-1px)}
    .sbf-wholesale-trust-item{padding:28px 24px;background:#e5dfd2;border-right:1px solid rgba(36,49,38,.12)}
    .sbf-wholesale-trust-item:last-child{border-right:0}
    .sbf-wholesale-trust-item strong{display:block;font-size:17px;margin-bottom:7px}
    .sbf-wholesale-trust-item span{font-size:14px;line-height:1.5}
    .sbf-wholesale-section{max-width:1200px;margin:0 auto;padding:95px 24px}
    .sbf-wholesale-section-head{max-width:780px;margin:0 auto 45px;text-align:center}
    .sbf-wholesale-section h2{font-size:clamp(34px,4.5vw,54px);line-height:1.03;letter-spacing:-.04em;margin:0 0 18px}
    .sbf-wholesale-section-head p{font-size:17px;line-height:1.7;margin:0}
    .sbf-wholesale-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .sbf-wholesale-card{background:#fff;box-shadow:0 8px 28px rgba(36,49,38,.07)}
    .sbf-wholesale-card img{display:block;width:100%;height:230px;object-fit:cover}
    .sbf-wholesale-card-copy{padding:25px}
    .sbf-wholesale-card h3{font-size:21px;line-height:1.2;margin:0 0 10px}
    .sbf-wholesale-card p{font-size:15px;line-height:1.65;margin:0}
    .sbf-wholesale-story{display:grid;grid-template-columns:1fr 1fr;background:#e5dfd2}
    .sbf-wholesale-story-image{min-height:460px}
    .sbf-wholesale-story-image img{display:block;width:100%;height:100%;object-fit:cover}
    .sbf-wholesale-story-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(35px,6vw,80px)}
    .sbf-wholesale-story-copy h2{font-size:clamp(34px,4vw,50px);line-height:1.05;letter-spacing:-.035em;margin:0 0 22px}
    .sbf-wholesale-story-copy p{font-size:17px;line-height:1.75;margin:0 0 16px}
    .sbf-wholesale-form-section{background:#243b2f;color:#fff;padding:95px 24px}
    .sbf-wholesale-form-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:start}
    .sbf-wholesale-form-intro h2{font-size:clamp(38px,4.8vw,58px);line-height:1;letter-spacing:-.04em;margin:0 0 22px}
    .sbf-wholesale-form-intro p{font-size:17px;line-height:1.7;color:rgba(255,255,255,.85);margin:0 0 25px}
    .sbf-wholesale-form-intro ul{padding-left:20px;margin:0}
    .sbf-wholesale-form-intro li{padding:5px 0;font-size:15px;line-height:1.5}
    .sbf-wholesale-form{background:#fff;color:#243126;padding:clamp(24px,4vw,42px)}
    .sbf-wholesale-form h3{font-size:25px;margin:0 0 8px}
    .sbf-wholesale-form .sbf-form-note{font-size:14px;line-height:1.55;color:#5c655d;margin:0 0 25px}
    .sbf-wholesale-fields{display:grid;grid-template-columns:1fr 1fr;gap:17px}
    .sbf-wholesale-field{display:flex;flex-direction:column;gap:7px;min-width:0}
    .sbf-wholesale-field.full{grid-column:1/-1}
    .sbf-wholesale-field label{font-size:12px;font-weight:700;letter-spacing:.04em}
    .sbf-wholesale-field input,.sbf-wholesale-field select,.sbf-wholesale-field textarea{width:100%;min-height:48px;border:1px solid #d4d7d0;border-radius:0;padding:12px 13px;background:#fff;color:#243126;font:inherit;font-size:15px}
    .sbf-wholesale-field textarea{min-height:115px;resize:vertical}
    .sbf-wholesale-field input:focus,.sbf-wholesale-field select:focus,.sbf-wholesale-field textarea:focus{outline:2px solid #78917e;outline-offset:1px}
    .sbf-wholesale-submit{margin-top:20px;width:100%;min-height:54px;border:0;background:#243b2f;color:#fff;padding:16px 22px;font:inherit;font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;cursor:pointer}
    .sbf-wholesale-submit:hover{background:#354f3e}
    .sbf-wholesale-success{padding:14px 16px;background:#e7f0e6;color:#243126;margin-bottom:20px;line-height:1.5}
    .sbf-wholesale-errors{padding:12px 15px;background:#fff0ed;color:#812f20;margin-bottom:18px;font-size:14px}
    .sbf-wholesale-bottom{padding:70px 24px;text-align:center;background:#e5dfd2}
    .sbf-wholesale-bottom h2{font-size:clamp(32px,4vw,46px);line-height:1.05;margin:0 0 15px;letter-spacing:-.035em}
    .sbf-wholesale-bottom p{font-size:16px;line-height:1.65;margin:0 auto 24px;max-width:680px}
    .sbf-wholesale-bottom .sbf-wholesale-btn{background:#243b2f;color:#fff;align-self:auto}
    @media(max-width:850px){
      .sbf-wholesale-hero,.sbf-wholesale-story{grid-template-columns:1fr}
      .sbf-wholesale-hero-copy{max-width:none;margin:0;padding:65px 30px}
      .sbf-wholesale-hero-image{min-height:360px;max-height:480px}
      .sbf-wholesale-trust{grid-template-columns:1fr;padding:0 18px}
      .sbf-wholesale-trust-item{border-right:0;border-bottom:1px solid rgba(36,49,38,.12);padding:22px}
      .sbf-wholesale-trust-item:last-child{border-bottom:0}
      .sbf-wholesale-cards{grid-template-columns:1fr 1fr}
      .sbf-wholesale-card:last-child{grid-column:1/-1}
      .sbf-wholesale-card:last-child img{height:250px}
      .sbf-wholesale-story-image{min-height:350px}
      .sbf-wholesale-form-grid{grid-template-columns:1fr;gap:35px}
    }
    @media(max-width:560px){
      .sbf-wholesale-section{padding:65px 18px}
      .sbf-wholesale-cards{grid-template-columns:1fr}
      .sbf-wholesale-card:last-child{grid-column:auto}
      .sbf-wholesale-card img,.sbf-wholesale-card:last-child img{height:230px}
      .sbf-wholesale-fields{grid-template-columns:1fr}
      .sbf-wholesale-field.full{grid-column:auto}
      .sbf-wholesale-form-section{padding:65px 16px}
      .sbf-wholesale-form{padding:23px 18px}
      .sbf-wholesale-story-copy{padding:45px 25px}
    }
  </style>

  <div class="sbf-wholesale">
    <section class="sbf-wholesale-hero">
      <div class="sbf-wholesale-hero-copy">
        <div class="sbf-wholesale-eyebrow">Wholesale &amp; Food Service</div>
        <h1>Good products.<br>Reliable supply.</h1>
        <p>Wholesale food and beverage solutions for restaurants, independent markets, and food-service businesses—backed by regional distribution experience and a local farm perspective.</p>
        <a class="sbf-wholesale-btn" href="#wholesale-inquiry">Request Wholesale Pricing</a>
      </div>
      <div class="sbf-wholesale-hero-image">
        <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&amp;fit=crop&amp;w=1500&amp;q=85" alt="Fresh produce displayed for food service and retail customers" loading="eager">
      </div>
    </section>

    <div class="sbf-wholesale-trust">
      <div class="sbf-wholesale-trust-item"><strong>Established in 1921</strong><span>Distribution heritage through Price Wholesale Distributors.</span></div>
      <div class="sbf-wholesale-trust-item"><strong>Regional Delivery</strong><span>Serving customers from Northern Virginia through Carroll County and north into York County, Pennsylvania.</span></div>
      <div class="sbf-wholesale-trust-item"><strong>Built for Business</strong><span>Wholesale support for restaurants, independent markets, and food-service operators.</span></div>
    </div>

    <section class="sbf-wholesale-section">
      <div class="sbf-wholesale-section-head">
        <div class="sbf-wholesale-eyebrow">Wholesale Partnerships</div>
        <h2>Supply that supports your business.</h2>
        <p>We help connect businesses with food and beverage products suited to their operation. Tell us what you need and where you do business, and we'll follow up about availability, delivery, and pricing.</p>
      </div>
      <div class="sbf-wholesale-cards">
        <article class="sbf-wholesale-card">
          <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="Food preparation in a professional kitchen" loading="lazy">
          <div class="sbf-wholesale-card-copy"><h3>Restaurants &amp; Kitchens</h3><p>Wholesale products for independent restaurants, kitchens, and food-service teams that need dependable supply.</p></div>
        </article>
        <article class="sbf-wholesale-card">
          <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="Fresh food selection for retail markets" loading="lazy">
          <div class="sbf-wholesale-card-copy"><h3>Independent Markets</h3><p>Food and beverage options for neighborhood markets, farm shops, and independent retailers.</p></div>
        </article>
        <article class="sbf-wholesale-card">
          <img src="https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="Fresh meat ingredients for food businesses" loading="lazy">
          <div class="sbf-wholesale-card-copy"><h3>Food &amp; Beverage Supply</h3><p>Discuss the products, brands, pack sizes, and delivery needs that make sense for your business.</p></div>
        </article>
      </div>
    </section>

    <section class="sbf-wholesale-story">
      <div class="sbf-wholesale-story-image">
        <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Business team discussing supply and service needs" loading="lazy">
      </div>
      <div class="sbf-wholesale-story-copy">
        <div class="sbf-wholesale-eyebrow">A Partnership with Experience</div>
        <h2>Local roots.<br>Wholesale experience.</h2>
        <p>Spring Bottom Farm brings a local, hands-on perspective to food and farm products. Through our partnership with Price Wholesale Distributors, a business established in 1921, we can discuss a broader range of wholesale food and beverage needs.</p>
        <p>Our regional focus spans Northern Virginia, Carroll County, and north into York County, Pennsylvania. Availability and delivery depend on your location and product requirements.</p>
      </div>
    </section>

    <section class="sbf-wholesale-form-section" id="wholesale-inquiry">
      <div class="sbf-wholesale-form-grid">
        <div class="sbf-wholesale-form-intro">
          <div class="sbf-wholesale-eyebrow">Start a Conversation</div>
          <h2>Request wholesale pricing.</h2>
          <p>Share a few details about your business and what you're looking for. We'll review your inquiry and get back to you about product availability, pricing, and delivery options.</p>
          <ul>
            <li>Restaurant and food-service inquiries</li>
            <li>Independent grocery and market inquiries</li>
            <li>Product availability and regional delivery questions</li>
          </ul>
        </div>
        <div class="sbf-wholesale-form">
          <h3>Wholesale inquiry</h3>
          <p class="sbf-form-note">Fields marked * are required. Submitting this form does not guarantee product availability or a delivery route.</p>
          {% form 'contact', id: 'WholesaleContactForm' %}
            {% if form.posted_successfully? %}
              <div class="sbf-wholesale-success" role="status">Thank you for your inquiry. Your information has been submitted to Spring Bottom Farm.</div>
            {% endif %}
            {% if form.errors %}
              <div class="sbf-wholesale-errors">{{ form.errors | default_errors }}</div>
            {% endif %}
            <input type="hidden" name="contact[subject]" value="Wholesale &amp; Food Service Inquiry">
            <div class="sbf-wholesale-fields">
              <div class="sbf-wholesale-field">
                <label for="WholesaleName">Your name *</label>
                <input id="WholesaleName" type="text" name="contact[name]" autocomplete="name" required>
              </div>
              <div class="sbf-wholesale-field">
                <label for="WholesaleBusiness">Business name *</label>
                <input id="WholesaleBusiness" type="text" name="contact[Business name]" autocomplete="organization" required>
              </div>
              <div class="sbf-wholesale-field">
                <label for="WholesaleEmail">Business email *</label>
                <input id="WholesaleEmail" type="email" name="contact[email]" autocomplete="email" required>
              </div>
              <div class="sbf-wholesale-field">
                <label for="WholesalePhone">Phone number</label>
                <input id="WholesalePhone" type="tel" name="contact[phone]" autocomplete="tel">
              </div>
              <div class="sbf-wholesale-field">
                <label for="WholesaleType">Business type *</label>
                <select id="WholesaleType" name="contact[Business type]" required>
                  <option value="" selected disabled>Select your business type</option>
                  <option>Restaurant / food service</option>
                  <option>Independent grocery or market</option>
                  <option>Farm store or specialty retailer</option>
                  <option>Caterer</option>
                  <option>Other business</option>
                </select>
              </div>
              <div class="sbf-wholesale-field">
                <label for="WholesaleLocation">City, state or ZIP *</label>
                <input id="WholesaleLocation" type="text" name="contact[Business location]" autocomplete="postal-code" required>
              </div>
              <div class="sbf-wholesale-field full">
                <label for="WholesaleProducts">Products or brands you're interested in</label>
                <input id="WholesaleProducts" type="text" name="contact[Products of interest]" placeholder="e.g. beverages, frozen products, farm products">
              </div>
              <div class="sbf-wholesale-field full">
                <label for="WholesaleDetails">Tell us about your needs</label>
                <textarea id="WholesaleDetails" name="contact[body]" placeholder="Products, approximate volume, delivery frequency, or questions…"></textarea>
              </div>
            </div>
            <button class="sbf-wholesale-submit" type="submit">Send Wholesale Inquiry</button>
          {% endform %}
        </div>
      </div>
    </section>

    <section class="sbf-wholesale-bottom">
      <div class="sbf-wholesale-eyebrow">Spring Bottom Farm × Price Wholesale Distributors</div>
      <h2>Let's talk about your supply needs.</h2>
      <p>Tell us what your business needs and where you operate. We'll help determine whether our products and delivery network are a fit.</p>
      <a class="sbf-wholesale-btn" href="#wholesale-inquiry">Request Wholesale Pricing</a>
    </section>
  </div>
{% else %}
  <div class="sbf-page">
    <div class="sbf-wrap">
      <h1>{{ page.title }}</h1>
      <div class="sbf-page-content">{{ page.content }}</div>
    </div>
  </div>
{% endif %}