<section id="our-farm" class="sbf-story sbf-section">
  <div class="sbf-wrap sbf-story-grid">
    <div class="sbf-story-image">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width:1500 | image_tag: loading:'lazy' }}
      {% else %}
        <div class="sbf-placeholder sbf-story-placeholder"></div>
      {% endif %}
    </div>
    <div class="sbf-story-copy">
      <div class="sbf-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="sbf-story-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{"name":"Our Farm Story","settings":[
{"type":"image_picker","id":"image","label":"Farm image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR FARM"},
{"type":"text","id":"heading","label":"Heading","default":"A working farm in Freeland, Maryland."},
{"type":"textarea","id":"text","label":"Text","default":"Spring Bottom Farm is a family-run farm in Freeland, Maryland, focused on raising quality food, caring for the land, and building a sustainable future. From pasture-raised eggs and seasonal produce to hay and livestock, everything we do comes back to hard work and a love for the land. We’re proud to be part of this community and share the fruits of our farm with our neighbors."},
{"type":"text","id":"button_label","label":"Button","default":"Our Story"},
{"type":"url","id":"button_link","label":"Button link","default":"/pages/our-farm"}
]}{% endschema %}
