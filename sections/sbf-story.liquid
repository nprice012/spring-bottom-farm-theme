<section id="our-farm" class="sbf-story sbf-section">
  <div class="sbf-wrap sbf-story-grid">
    <div class="sbf-story-image">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width:1500 | image_tag: loading:'lazy' }}
      {% else %}
        <div class="sbf-placeholder sbf-story-placeholder"></div>
      {% endif %}
    </div>
    <div class="sbf-story-copy">
      <div class="sbf-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="sbf-link" href="{{ section.settings.button_link | default: '#our-farm' }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

<style>
  .sbf-story-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:70px;align-items:center}
  .sbf-story-image{grid-column:2;grid-row:1;overflow:hidden;border-radius:6px}
  .sbf-story-copy{grid-column:1;grid-row:1}
  .sbf-story-image img{display:block;width:100%;height:100%;min-height:520px;object-fit:cover}
  .sbf-story-copy h2{font-size:clamp(42px,5vw,68px);line-height:.98;margin:0 0 28px;letter-spacing:-.04em}
  .sbf-story-copy p{font-size:18px;line-height:1.65;margin:0 0 30px}
  @media screen and (max-width:749px){
    .sbf-story-grid{grid-template-columns:1fr;gap:35px}
    .sbf-story-image{grid-column:1;grid-row:1}
    .sbf-story-copy{grid-column:1;grid-row:2}
    .sbf-story-image img{min-height:360px}
  }
</style>

{% schema %}
{"name":"Our Farm Story","settings":[
{"type":"image_picker","id":"image","label":"Farm image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR FARM"},
{"type":"text","id":"heading","label":"Heading","default":"Rooted in Real Life."},
{"type":"textarea","id":"text","label":"Text","default":"Spring Bottom Farm is a family-run farm in Freeland, Maryland, focused on raising quality food, caring for the land, and building a sustainable future. From pasture-raised eggs and seasonal produce to hay and livestock, everything we do is rooted in hard work and a love for the land. We’re proud to be part of this community and share the fruits of our farm with our neighbors."},
{"type":"text","id":"button_label","label":"Button","default":"Our Story"},
{"type":"url","id":"button_link","label":"Button link"}
]}{% endschema %}