<section class="sbf-feature">
  <div class="sbf-feature-image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
    {% else %}
      <div class="sbf-placeholder"></div>
    {% endif %}
  </div>

  <div class="sbf-feature-copy">
    <div>
      <div class="sbf-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="sbf-btn sbf-btn-light" href="{{ section.settings.button_link | default: '/pages/egg-subscription' }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Egg Subscription Feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EGG SUBSCRIPTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh eggs, on your schedule."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Get pasture-raised eggs from Spring Bottom Farm on a schedule that works for you. Choose weekly or every-other-week and never worry about running out of fresh eggs."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "START YOUR EGG SUBSCRIPTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}