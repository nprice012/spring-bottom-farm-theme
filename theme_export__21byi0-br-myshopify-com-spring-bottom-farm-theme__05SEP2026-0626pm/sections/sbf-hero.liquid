<section class="sbf-hero">
  <div class="sbf-hero-bg">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager' }}
    {% else %}
      <div class="sbf-placeholder"></div>
    {% endif %}
  </div>
  <div class="sbf-hero-overlay"></div>
  <div class="sbf-wrap sbf-hero-content">
<div class="sbf-hero-logo"><img src="{{ 'sbf-logo.PNG' | asset_url }}" alt="Spring Bottom Farm"></div>    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <a class="sbf-btn sbf-btn-light" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }}</a>
  </div>
</section>
{% schema %}
{"name":"Farm Hero","settings":[
{"type":"image_picker","id":"image","label":"Hero image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SPRING BOTTOM FARM"},
{"type":"text","id":"heading","label":"Heading","default":"Good food starts here."},
{"type":"textarea","id":"text","label":"Text","default":"Fresh eggs, seasonal produce, and farm-made goods from our family farm."},
{"type":"text","id":"button_label","label":"Button","default":"Shop the Farm"},
{"type":"url","id":"button_link","label":"Button link"}
]}{% endschema %}