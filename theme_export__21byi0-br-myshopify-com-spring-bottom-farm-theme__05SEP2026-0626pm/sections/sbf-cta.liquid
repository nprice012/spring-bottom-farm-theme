<section class="sbf-cta">
  <div class="sbf-wrap sbf-narrow">

    <img
      src="{{ 'sbf-logo.PNG' | asset_url }}"
      alt="{{ shop.name }}"
      class="sbf-cta-logo"
      loading="lazy"
    >

    <div class="sbf-eyebrow">{{ section.settings.eyebrow }}</div>

    <h2>{{ section.settings.heading }}</h2>

    <p>{{ section.settings.text }}</p>

    <a
      class="sbf-btn sbf-btn-light"
      href="{{ section.settings.button_link | default: routes.collections_url }}"
    >
      {{ section.settings.button_label }}
    </a>

  </div>
</section>

{% schema %}
{
  "name": "Final Call to Action",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SPRING BOTTOM FARM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good local food starts here."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "From pasture-raised eggs and farm-raised beef to seasonal produce, poultry, firewood, and Italian ice, we're proud to offer food and goods from our family farm."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}